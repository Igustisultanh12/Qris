APP_NAME="PT Kreatif Abadi QRIS Platform"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=qris_platform
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# QRIS Engine Defaults
QRIS_DEFAULT_EXPIRY_MINUTES=15
QRIS_DEFAULT_FEE_MODE=charged_to_customer
QRIS_DEFAULT_RATE_LIMIT_RPM=60

# Payment Gateway Drivers (Midtrans, Xendit, Tripay, Manual)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=

TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_MODE=sandbox

# Backup Storage
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=devops@kreatifabadi.co.id

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="/api"
